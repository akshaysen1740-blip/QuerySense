# Copy to .env and adjust. Every setting can also be passed as an environment variable.
SIGNALSIFT_EMBEDDER=lsa                 # lsa (offline, default) | sbert (needs .[ml])
SIGNALSIFT_SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIGNALSIFT_RERANKER=heuristic           # none | heuristic | cross-encoder (needs .[ml])
SIGNALSIFT_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SIGNALSIFT_VECTOR_BACKEND=numpy         # numpy | faiss (needs .[ml])
SIGNALSIFT_CLUSTER_METHOD=kmeans        # kmeans | bertopic (needs .[ml])
SIGNALSIFT_N_TOPICS=0                   # 0 = pick automatically via silhouette
SIGNALSIFT_TREND_FREQ=D                 # h | D | W
SIGNALSIFT_SPIKE_Z=3.0
SIGNALSIFT_DUPLICATE_THRESHOLD=0.85
SIGNALSIFT_INCIDENT_MIN_SIZE=8
SIGNALSIFT_INCIDENT_WINDOW_HOURS=48
SIGNALSIFT_REDACT_PII=true
SIGNALSIFT_MAX_ROWS=50000
SIGNALSIFT_SESSION_DIR=.sessions
SIGNALSIFT_UI_MODE=local                # local (in-process) | api (talk to FastAPI)
SIGNALSIFT_API_URL=http://localhost:8000
